# ============================================================
# Modèle .env de production — GMAO ARGOS
# À copier dans backend/.env sur le VPS
# Les valeurs DATABASE_URL et JWT_SECRET sont affichées par
# setup-vps.sh à la fin du provisioning : reportez-les ici.
# ============================================================

NODE_ENV=production

# Bind interne uniquement (Nginx fait le reverse proxy)
HOST=127.0.0.1
PORT=4000

# Postgres local (mot de passe généré par setup-vps.sh)
DATABASE_URL=postgresql://gmao:CHANGE_ME@localhost:5432/gmao_argos?schema=public

# Clé JWT — générer avec : openssl rand -hex 64
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_64
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# CORS : domaine officiel uniquement en prod
CORS_ORIGIN=https://gmao.argos-oi.fr

# Stockage fichiers : disk en local, s3 si bucket configuré
UPLOAD_PROVIDER=disk
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760

# --- Configuration S3 (optionnelle, si UPLOAD_PROVIDER=s3) ---
# S3_REGION=auto
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_BUCKET=argos-gmao-prod
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=https://argos-gmao-prod.s3.fr-par.scw.cloud

# Sert le frontend statique sur la même origine
SERVE_FRONTEND=true
FRONTEND_DIR=../

# Compte super-admin créé au seed initial — A CHANGER APRES LE 1ER LOGIN
SEED_SUPER_LOGIN=admin
SEED_SUPER_PASSWORD=ChangezMoiUrgemment!
SEED_SUPER_NAME="Administrateur ARGOS"
