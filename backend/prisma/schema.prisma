// ============================================================
// Schéma Prisma GMAO ARGOS OCEAN INDIEN
// Provider SQLite par défaut (file:./dev.db). Pour passer à PostgreSQL :
//   1. Remplacer `provider = "sqlite"` par `provider = "postgresql"`
//   2. Mettre à jour DATABASE_URL en .env
//   3. npm run prisma:migrate
// (Le script "npm run use:postgres" automatise ce switch)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Utilisateurs (admins, techniciens, clients)
// ============================================================

model User {
  id          String   @id @default(uuid())
  kind        String   // 'admin' | 'tech' | 'client'
  login       String   @unique
  password    String   // bcrypt hash
  name        String
  email       String?
  phone       String?
  active      Boolean  @default(true)   // false = compte désactivé (login refusé)

  // Admin
  superAdmin  Boolean  @default(false)
  permissions String?  // JSON sérialisé : { tickets:'write', ... }

  // Tech
  specialty   String?
  color       String?

  // Client (utilisateur rattaché à un client)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Relations
  ticketsCreated     Ticket[]            @relation("ticketCreatedBy")
  ticketAssignments  TicketTechnician[]
  ticketComments     TicketComment[]
  chantiersCreated   Chantier[]          @relation("chantierCreatedBy")
  chantierAssignments ChantierTechnician[]
  chantierComments   ChantierComment[]
  accidentsCreated   Accident[]          @relation("accidentCreatedBy")
  derogationsCreated Derogation[]        @relation("derogationCreatedBy")
  bulletinsCreated   Bulletin[]          @relation("bulletinCreatedBy")
  bulletinReads      BulletinRead[]
  bulletinComments   BulletinComment[]
  leaves             Leave[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind])
  @@index([clientId])
}

// ============================================================
// Référentiels
// ============================================================

model Client {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  contact       String?
  email         String?
  phone         String?
  address       String?
  portalEnabled Boolean  @default(true)  // false = portail client désactivé (login refusé)

  sites     Site[]
  products  Product[]
  tickets   Ticket[]
  chantiers Chantier[]
  accidents Accident[]
  derogations Derogation[]
  users     User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Site {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  address       String?
  contact       String?
  contactPhone  String?
  contactEmail  String?
  lat           Float?
  lng           Float?

  products      Product[]
  tickets       Ticket[]
  chantiers     Chantier[]
  accidents     Accident[]
  derogations   Derogation[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
}

model Product {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reference   String?
  name        String
  description String?

  tickets     Ticket[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([siteId])
}

// ============================================================
// Tickets
// ============================================================

model Ticket {
  id                       String   @id @default(uuid())
  number                   String   @unique
  clientId                 String
  client                   Client   @relation(fields: [clientId], references: [id])
  siteId                   String
  site                     Site     @relation(fields: [siteId], references: [id])
  productId                String?
  product                  Product? @relation(fields: [productId], references: [id])

  title                    String
  description              String?
  interventionDescription  String?
  priority                 String   // basse|normale|haute|urgente
  status                   String   // nouveau|planifie|en_cours|resolu|cloture

  scheduledAt              DateTime?
  scheduledEnd             DateTime?
  hours                    Float    @default(0)
  tripCount                Int      @default(0)

  // Signatures
  signature                String?  // URL ou data URL
  signatureDate            DateTime?
  signerName               String?
  techSignature            String?
  techSignatureDate        DateTime?

  createdById              String?
  createdBy                User?    @relation("ticketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt                DateTime @default(now())
  completedAt              DateTime?
  updatedAt                DateTime @updatedAt

  technicians              TicketTechnician[]
  comments                 TicketComment[]

  @@index([clientId])
  @@index([siteId])
  @@index([status])
  @@index([scheduledAt])
}

model TicketTechnician {
  ticketId      String
  technicianId  String
  ticket        Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technician    User   @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@id([ticketId, technicianId])
  @@index([technicianId])
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String  // dénormalisé pour archive
  role      String   // admin|tech|client
  text      String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ============================================================
// Chantiers
// ============================================================

model Chantier {
  id            String   @id @default(uuid())
  number        String   @unique
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id])

  name          String
  numAffaire    String?
  description   String?
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  address       String?
  lat           Float?
  lng           Float?
  tasks         String?

  scheduledAt   DateTime?
  duration      Int      @default(1) // jours
  hours         Float    @default(0) // budget total homme-heures alloué
  hoursDone     Float    @default(0) // heures réellement réalisées (saisie tech/admin)

  createdById   String?
  createdBy     User?    @relation("chantierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  technicians   ChantierTechnician[]
  comments      ChantierComment[]
  schedules     ChantierSchedule[]

  @@index([clientId])
  @@index([siteId])
}

model ChantierSchedule {
  id            String   @id @default(uuid())
  chantierId    String
  chantier      Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  durationHours Float    @default(8)
  comment       String?
  createdAt     DateTime @default(now())

  @@index([chantierId])
  @@index([scheduledAt])
}

model Leave {
  id            String   @id @default(uuid())
  technicianId  String
  technician    User     @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  type          String   @default("conge")   // conge|rtt|maladie|formation|autre
  comment       String?
  createdAt     DateTime @default(now())

  @@index([technicianId])
  @@index([startDate])
}

model NotificationRule {
  id            String   @id @default(uuid())
  label         String?                          // libellé libre pour identifier la règle
  event         String                           // ticket_created | ticket_completed | accident_created | derogation_created | derogation_validated | bulletin_published
  recipientType String   @default("email")       // 'email' | 'user'
  email         String?                          // si recipientType='email'
  userId        String?                          // si recipientType='user'
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([event, active])
}

model NotificationLog {
  id           String   @id @default(uuid())
  event        String
  recipient    String                            // email final résolu
  subject      String
  ok           Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

model ChantierTechnician {
  chantierId    String
  technicianId  String
  chantier      Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  technician    User     @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@id([chantierId, technicianId])
  @@index([technicianId])
}

model ChantierComment {
  id          String   @id @default(uuid())
  chantierId  String
  chantier    Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String
  role        String
  text        String
  createdAt   DateTime @default(now())

  @@index([chantierId])
}

// ============================================================
// Sécurité — presque-accidents, dérogations, bulletins
// ============================================================

model Accident {
  id                 String   @id @default(uuid())
  number             String   @unique
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id])
  siteId             String
  site               Site     @relation(fields: [siteId], references: [id])

  title              String
  description        String
  riskNature         String
  recommendations    String?  // tech
  qseRecommendations String?  // QSE / admin
  status             String   @default("en_cours") // en_cours|traite

  createdById        String?
  createdBy          User?    @relation("accidentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  photos             AccidentPhoto[]
}

model AccidentPhoto {
  id         String   @id @default(uuid())
  accidentId String
  accident   Accident @relation(fields: [accidentId], references: [id], onDelete: Cascade)
  url        String   // chemin /uploads/... ou URL S3
  position   Int      @default(0)
  createdAt  DateTime @default(now())
}

model Derogation {
  id                  String   @id @default(uuid())
  number              String   @unique
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id])
  siteId              String
  site                Site     @relation(fields: [siteId], references: [id])

  title               String
  description         String
  dateStart           DateTime
  dateEnd             DateTime
  riskAnalysis        String
  preventiveMeasures  String?  // QSE
  techRecommendations String?  // tech

  techSignature       String?
  techSignatureDate   DateTime?
  respSignature       String?
  respSignatureDate   DateTime?

  status              String   @default("en_cours") // en_cours|valide

  createdById         String?
  createdBy           User?    @relation("derogationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  photos              DerogationPhoto[]
}

model DerogationPhoto {
  id            String     @id @default(uuid())
  derogationId  String
  derogation    Derogation @relation(fields: [derogationId], references: [id], onDelete: Cascade)
  url           String
  position      Int        @default(0)
  createdAt     DateTime   @default(now())
}

model Bulletin {
  id            String   @id @default(uuid())
  number        String   @unique
  title         String
  bulletinDate  DateTime?
  info          String

  createdById   String?
  createdBy     User?    @relation("bulletinCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reads         BulletinRead[]
  comments      BulletinComment[]
}

model BulletinRead {
  bulletinId    String
  technicianId  String
  readAt        DateTime @default(now())
  bulletin      Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  technician    User     @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@id([bulletinId, technicianId])
}

model BulletinComment {
  id          String   @id @default(uuid())
  bulletinId  String
  bulletin    Bulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String
  role        String
  text        String
  createdAt   DateTime @default(now())
}

// ============================================================
// Compteurs séquentiels (pour numéros INT-2026-XXXX, etc.)
// ============================================================

model Sequence {
  key       String   @id  // 'ticket'|'accident'|'derogation'|'chantier'|'bulletin'
  year      Int
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ============================================================
// Audit log (RGPD)
// ============================================================

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  userId      String?
  userKind    String?
  action      String
  entityType  String?
  entityId    String?
  payload     String?  // JSON sérialisé
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
