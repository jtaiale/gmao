# ============================================================
# GMAO ARGOS — Configuration backend
# Copier en .env et adapter selon l'environnement
# ============================================================

# Base de données : SQLite par défaut (zero-config), PostgreSQL pour la prod
# SQLite (dev) :
DATABASE_URL="file:./dev.db"

# PostgreSQL (production) — décommenter et adapter :
# DATABASE_URL="postgresql://gmao:gmao_password@localhost:5432/gmao_argos?schema=public"

# Serveur HTTP
HOST=0.0.0.0
PORT=4000
NODE_ENV=development

# JWT — IMPORTANT : changer la clé en production (commande : openssl rand -hex 64)
JWT_SECRET="dev-secret-please-change-in-production-32-chars-min"
JWT_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS : origines autorisées (séparées par virgule). * = tout autorisé (dev seulement)
CORS_ORIGIN="http://localhost:5173,http://localhost:8080,*"

# Stockage fichiers : 'disk' (local) ou 's3' (à implémenter)
UPLOAD_PROVIDER=disk
UPLOAD_DIR="./uploads"
UPLOAD_MAX_BYTES=10485760

# Compte super-admin créé au seed (changer le mot de passe ensuite via le backoffice)
SEED_SUPER_LOGIN=admin
SEED_SUPER_PASSWORD=admin
SEED_SUPER_NAME="Super Administrateur"

# Servir le frontend statique (proto) depuis ce backend ?
# Pratique en dev pour tout sur un seul port
SERVE_FRONTEND=true
FRONTEND_DIR="../"
